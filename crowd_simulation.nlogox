<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  ;; Simulation Flow
  exited-people
  evacuation-time
  total-people
  exit-left-count
  exit-right-count
  avg-exit-time
  
  ;; Safety Metrics
  bottleneck-detected
  max-density
  injured-count
  death-count
  last-exited-count
  flow-rate
  
  panic-started
  evacuation-efficiency
  early-exits-count
  peak-crowd-time
  evacuation-started-at
  
  ;; Demographic Escapees
  female-escapees
  male-escapees
  child-escapees
  adult-escapees
  elderly-escapees
  
  ;; Stampede Deaths by Demographics
  female-stampede-deaths
  male-stampede-deaths
  child-stampede-deaths
  adult-stampede-deaths
  elderly-stampede-deaths
  
  ;; Interface Variables (Sliders/Switches)

  
  
  sansa-za-smrt
  
  
  
  
  
  
  ;; Tuning constants
  collision-radius
  repulsion-strength
  injury-threshold
]

turtles-own [
  speed
  state
  personality
  wander-timer
  stress-level
  exit-start-time
  chosen-exit
  injured?
  stuck-counter
  dead?
  last-xcor
  last-ycor
  feeling-unwell?
  unwell-time
  
  ;; Demographics
  gender        ;; "male" or "female"
  age-group     ;; "child", "adult", or "elderly"
  mass          ;; kg, affects force in stampedes
  vision        ;; patches, how far they can see hazards
  health        ;; threshold for stampede death
  base-speed    ;; unmodified speed
  panic-level   ;; 0-3, increases speed near crowds
]

patches-own [
  density
  is-obstacle?
  is-exit?          ;; Persistent flag for exit detection
  distance-to-exit  ;; Precomputed pathfinding field
  heat-intensity    ;; For professional heatmap
]

to-report is-exit-patch?
  report is-exit?
end

to-report is-walkable?
  report (not is-obstacle?) or is-exit?
end

to setup
  clear-all
  initialize-globals
  setup-room
  setup-obstacles
  setup-people
  
  compute-distance-field

  print (word "Postavka simulacije je završena.")
  print (word "Trajanje koncerta: " concert-duration " tickova.")
  print (word "Ukupan broj osoba: " count turtles)
  print (word "Broj osoba u koncertnom režimu: " count turtles with [state = "concert"])

  reset-ticks
end

to initialize-globals
  set exited-people 0
  set evacuation-time 0
  set exit-left-count 0
  set exit-right-count 0
  set avg-exit-time 0
  set bottleneck-detected false
  set max-density 0
  set injured-count 0
  set death-count 0
  set last-exited-count 0
  set flow-rate 0
  set panic-started false
  set evacuation-efficiency 0
  set early-exits-count 0
  set peak-crowd-time 0
  set evacuation-started-at 0
  
  ;; Initialize demographic escapees
  set female-escapees 0
  set male-escapees 0
  set child-escapees 0
  set adult-escapees 0
  set elderly-escapees 0
  
  ;; Initialize stampede deaths
  set female-stampede-deaths 0
  set male-stampede-deaths 0
  set child-stampede-deaths 0
  set adult-stampede-deaths 0
  set elderly-stampede-deaths 0
  
  ;; Tuning constants
  set collision-radius 0.6
  set repulsion-strength 0.2
  set injury-threshold 15 ;; Number of turtles in-radius 1 before risk of injury
end

to setup-room
  ask patches [
    set pcolor black
    set is-obstacle? false
    set is-exit? false
  ]

  ask patches with [
    pxcor = min-pxcor or pxcor = max-pxcor or
    pycor = min-pycor or pycor = max-pycor
  ] [
    set pcolor 2 + random 2
    set is-obstacle? true
  ]

  ask patches with [pycor > max-pycor - 6] [
    let stage-depth max-pycor - pycor
    set pcolor 15 - (stage-depth * 0.5)
    set is-obstacle? true
  ]

  ask n-of 8 patches with [pycor = max-pycor - 2 or pycor = max-pycor - 3] [
    set pcolor one-of [yellow orange 47]
  ]

  ask patches with [
    pycor > max-pycor - 12 and pycor <= max-pycor - 6 and
    pcolor != yellow and pcolor != orange and pcolor != 47
  ] [
    set pcolor 1
  ]

  ask patches with [pxcor = min-pxcor and abs pycor <= 5] [
    set pcolor 65
  ]
  ask patches with [pxcor = min-pxcor + 1 and abs pycor <= 5] [
    set pcolor 63
  ]
  ask patches with [pxcor = min-pxcor + 2 and abs pycor <= 3] [
    set pcolor 62
  ]

  ask patches with [pxcor = max-pxcor and abs pycor <= 5] [
    set pcolor 65
  ]
  ask patches with [pxcor = max-pxcor - 1 and abs pycor <= 5] [
    set pcolor 63
  ]
  ask patches with [pxcor = max-pxcor - 2 and abs pycor <= 3] [
    set pcolor 62
  ]

  ;; Third Exit (Bottom) - Only if broj-izlaza = 3
  if broj-izlaza = 3 [
    ask patches with [pycor = min-pycor and abs pxcor <= 5] [
      set pcolor 65
    ]
    ask patches with [pycor = min-pycor + 1 and abs pxcor <= 5] [
      set pcolor 63
    ]
    ask patches with [pycor = min-pycor + 2 and abs pxcor <= 3] [
      set pcolor 62
    ]
  ]
  
  ;; Mark exits permanently and ensure they are NOT obstacles
  ask patches with [pcolor = 65 or pcolor = 63 or pcolor = 62] [
    set is-exit? true
    set is-obstacle? false
  ]
end

to setup-obstacles
  if add-obstacles [
    ask patches with [
      (pxcor = min-pxcor + 8 or pxcor = max-pxcor - 8) and
      pycor >= max-pycor - 8 and pycor < max-pycor - 6
    ] [
      set pcolor 35
      set is-obstacle? true
      ask neighbors4 [
        if pcolor = black or pcolor = 1 [
          set pcolor 37
          set is-obstacle? true
        ]
      ]
    ]

    ask patches with [
      pycor = min-pycor + 8 and
      pxcor > 5 and pxcor < max-pxcor - 8
    ] [
      set pcolor 33
      set is-obstacle? true
    ]
    ask patches with [
      pycor = min-pycor + 9 and
      pxcor > 5 and pxcor < max-pxcor - 8
    ] [
      set pcolor 36
    ]
  ]
end

to compute-distance-field
  ;; Breadth-First Search to calculate distance to nearest exit
  ask patches [ set distance-to-exit 999 ]
  let wavefront patches with [is-exit?]
  ask wavefront [ set distance-to-exit 0 ]
  
  let d 1
  let max-iter 500 ;; Sufficiently high for any path
  let progress? true
  while [progress? and d < max-iter] [
    let next-wavefront patches with [
      distance-to-exit = 999 and 
      not is-obstacle? and 
      any? neighbors with [distance-to-exit = d - 1]
    ]
    ifelse any? next-wavefront [
      ask next-wavefront [ set distance-to-exit d ]
      set d d + 1
    ] [
      set progress? false
    ]
  ]
end

to setup-people
  let safe-patches patches with [
    is-walkable? and
    pxcor > min-pxcor + 3 and pxcor < max-pxcor - 3 and
    pycor > min-pycor + 3 and pycor < max-pycor - 7
  ]

  create-turtles ukupno-prisutnih [
    move-to one-of safe-patches
    set shape "person"
    set size 1.2
    ;; Varied colors for concert-goers
    set color one-of [cyan sky turquoise lime white yellow]
    
    ;; Assign demographics
    set gender ifelse-value (random 100 < 50) ["female"] ["male"]
    
    let age-roll random 100
    ifelse age-roll < 15 [
      set age-group "child"
    ] [
      ifelse age-roll < 85 [
        set age-group "adult"
      ] [
        set age-group "elderly"
      ]
    ]
    
    ;; Mass based on age and gender
    if age-group = "child" [ set mass 30 + random 10 ]
    if age-group = "adult" [
      ifelse gender = "male" [ set mass 70 + random 20 ] [ set mass 55 + random 20 ]
    ]
    if age-group = "elderly" [
      ifelse gender = "male" [ set mass 65 + random 15 ] [ set mass 55 + random 15 ]
    ]
    
    ;; Vision based on age
    if age-group = "child" [ set vision 3 + random 2 ]
    if age-group = "adult" [ set vision 5 + random 3 ]
    if age-group = "elderly" [ set vision 3 + random 3 ]
    
    ;; Health threshold
    if age-group = "child" [ set health 800 + random 400 ]
    if age-group = "adult" [
      ifelse gender = "male" [ set health 1800 + random 700 ] [ set health 1500 + random 600 ]
    ]
    if age-group = "elderly" [ set health 1000 + random 800 ]
    
    ;; Base speed
    if age-group = "child" [ set base-speed (prosjecna-brzina-kretanja * 0.9) + (random-float (prosjecna-brzina-kretanja * 0.3)) ]
    if age-group = "adult" [ set base-speed (prosjecna-brzina-kretanja * 0.8) + (random-float (prosjecna-brzina-kretanja * 0.4)) ]
    if age-group = "elderly" [ set base-speed (prosjecna-brzina-kretanja * 0.6) + (random-float (prosjecna-brzina-kretanja * 0.3)) ]
    
    set speed base-speed
    set panic-level 0
    set personality random 3
    set stress-level 0
    set state "concert"
    set chosen-exit ""
    set injured? false
    set dead? false
    set feeling-unwell? (random-float 100 < sansa-za-nelagodu)
    set stuck-counter 0
    set unwell-time 0
    set last-xcor xcor
    set last-ycor ycor
  ]

  set total-people count turtles
  print (word "U prostor koncerta je ušlo " total-people " osoba.")
end

to go
  update-density

  ifelse ticks >= concert-duration [
    if not panic-started [
      initiate-evacuation
    ]
    
    ;; Panic and stampede systems during evacuation
    update-panic-levels
    calculate-stampede-forces
    
    ;; FORCE CLEANUP: Absolute stop for anyone still inside 300 ticks after concert
    ;; This is the ultimate "broom" that clears everyone.
    if ticks > concert-duration + 300 and any? turtles [
      ask turtles [
        record-exit (feeling-unwell? or state = "early-exit")
        die
      ]
      print (word "ZAVRŠNA ČISTKA: Svi preostali su evakuisani u ticku " ticks)
    ]

    ;; Normal evacuation behavior - for everyone
    ask turtles [ execute-evacuation-logic ]
    detect-bottlenecks
  ] [
    ;; During concert
    concert-behavior
    ;; People who feel unwell leave immediately
    ask turtles with [state = "early-exit"] [ execute-evacuation-logic ]
  ]

  update-statistics
  check-completion
  
  ;; Total Stop: If everyone (who didn't die) is gone, stop the 'go' button
  if not any? turtles with [not dead?] [
     print "Simulacija je završena - svi su izašli."
     stop
  ]
  
  tick
end

to execute-evacuation-logic
  ;; Dead people do not participate in any logic
  if dead? [ stop ]

  handle-stuck
  
  ;; Navigation: Only face target if we aren't currently wiggling or stuck
  if stuck-counter = 0 [
    let target-p min-one-of neighbors with [is-walkable?] [distance-to-exit]
    if target-p != nobody [ face target-p ]
  ]
  
  apply-professional-movement
  
  if state = "exit" [ update-state-visuals ]
  
  ;; Final exit check
  if is-exit? or any? neighbors with [is-exit?] [
    record-exit (feeling-unwell? or state = "early-exit")
    die
  ]
end

to concert-behavior
  ask turtles with [state = "concert" and not feeling-unwell?] [
    if not feeling-unwell? and random-float 100000 < 1 [
      set feeling-unwell? true
      set unwell-time ticks
      set color pink
      set state "early-exit"
      set exit-start-time ticks
      set stress-level 5

      print (word "Osoba se osjetila loše u ticku " ticks " i napušta koncert prije završetka.")
    ]

    let nearby-early-exit one-of turtles in-radius 2 with [state = "early-exit"]

    ifelse nearby-early-exit != nobody [
      face nearby-early-exit
      rt 180
      rt random 40 - 20
      let escape-patch patch-ahead 0.5
      if escape-patch != nobody and [is-walkable?] of escape-patch [
        fd 0.5
      ]
    ] [
      if random 100 < 20 [
        rt random 60 - 30
        let ahead patch-ahead 0.3
        if ahead != nobody and [is-walkable?] of ahead [
          fd 0.3
        ]
      ]
    ]
  ]

end



to handle-stuck
  ;; Movement check
  let d distancexy last-xcor last-ycor
  ifelse d < (speed * 0.1) [
    set stuck-counter stuck-counter + 1
  ] [
    set stuck-counter 0
  ]
  set last-xcor xcor
  set last-ycor ycor

  ;; FAIL-SAFE: Instant exit if on or adjacent to exit
  if is-exit? or any? neighbors with [is-exit?] [
    record-exit (state = "early-exit" or feeling-unwell?)
    die
  ]

  ;; If stuck, take aggressive measures
  if stuck-counter > 5 [
    rt (random 120 - 60)
    
    ;; Moderate push
    if stuck-counter > 15 [
      let safety-exit min-one-of patches with [is-exit?] [distance myself]
      if safety-exit != nobody [ face safety-exit ]
      jump 0.5
    ]
    
    ;; ABSOLUTE EMERGENCY: If stuck for too long, just finish
    if stuck-counter > 50 [
      let rescued-exit one-of patches with [is-exit?]
      if rescued-exit != nobody [
        move-to rescued-exit
        record-exit (state = "early-exit" or feeling-unwell?)
        die
      ]
    ]
  ]
end

to apply-professional-movement
  ;; Crowd Physics: Social Force
  ;; ONLY if NOT stuck. This allows them to "ignore" others to break free.
  if not injured? and stuck-counter = 0 [
    let nearby-turtles other turtles in-radius 0.3
    if any? nearby-turtles [
      let separator one-of nearby-turtles
      set heading (heading + (subtract-headings heading (towards separator)) * 0.1)
    ]
  ]
  
  ;; Determine movement step
  let step speed
  if state = "exit" [
     ;; Base evacuation speed tied to average speed slider
     set step (speed * (1 + stress-level / 120))
     ;; Panic behavior: active if global switch is ON OR if stress exceeds threshold
     if panic-mode or (stress-level >= nivo-stresa-za-paniku) [ 
       set step (step * 1.5) 
     ]
     ;; Standardize injured speed to a slow moving pace
     if injured? [ set step 0.1 ] 
  ]
  if state = "early-exit" [ set step (speed * 1.2) ]
  
  ;; Move forward if possible
  let ahead patch-ahead step
  ifelse ahead != nobody and [is-walkable?] of ahead [
     fd step
  ] [
     ;; If blocked, just turn. DON'T face target here to avoid override!
     rt (random 120 - 60)
  ]
end

to update-state-visuals
  if stress-level < 100 [
    set stress-level stress-level + 0.5
  ]
  
  if not injured? and not dead? [
    if stress-level < 30 [set color yellow]
    if stress-level >= 30 and stress-level < 60 [set color orange]
    if stress-level >= 60 [set color red]
  ]
  
  ;; Death Progression
  if injured? and not dead? [
    ;; If in extremely high density, there is a risk of death
    if count other turtles in-radius 0.8 > (injury-threshold + 2) [
      ;; Probability of death - very low
      if random 1000 < 1 [
        set dead? true
        set speed 0
        set color 9.9 ;; White for dead
        set death-count death-count + 1
      ]
    ]
  ]

  ;; Crowd Crush Check - only for non-injured to prevent infinite slowdown
  ;; Injuries ONLY if stress is high (panic) and based on slider
  ;; Added 2% cap for total casualties (injured + dead)
  let total-casualties (injured-count + death-count)
  let casualty-cap (total-people * 0.02)
  
  if not injured? and not dead? and (panic-mode or stress-level >= nivo-stresa-za-paniku) and total-casualties < casualty-cap [
    if count other turtles in-radius 1 > injury-threshold [
       ;; Probability of injury based on slider
       if random-float 100 < sansa-za-povredu [
         set injured? true
         set color 115 ;; Violet for injured
         set injured-count injured-count + 1
       ]
    ]
  ]
  
  ;; Independent death chance based on slider
  if not dead? and random-float 100 < sansa-za-smrt [
      set dead? true
      set speed 0
      set color 9.9 ;; White for dead
      set death-count death-count + 1
  ]
end

to record-exit [is-early]
  set exited-people exited-people + 1
  
  ;; Track by gender
  ifelse gender = "female" [
    set female-escapees female-escapees + 1
  ] [
    set male-escapees male-escapees + 1
  ]
  
  ;; Track by age
  if age-group = "child" [ set child-escapees child-escapees + 1 ]
  if age-group = "adult" [ set adult-escapees adult-escapees + 1 ]
  if age-group = "elderly" [ set elderly-escapees elderly-escapees + 1 ]
  
  ;; Determine exit side for stats
  let exit-side ifelse-value (pxcor < 0) ["left"]["right"]
  ifelse exit-side = "left" [
    set exit-left-count exit-left-count + 1
  ] [
    set exit-right-count exit-right-count + 1
  ]
  
  if is-early [
    set early-exits-count early-exits-count + 1
    print (word "Rani izlazak broj " early-exits-count " je završen.")
  ]
end

to update-panic-levels
  ask turtles with [not dead? and state = "exit"] [
    let nearby-count count other turtles in-radius 2
    
    if nearby-count >= 15 [
      set panic-level 3
      set speed base-speed * 1.8
    ]
    if nearby-count >= 10 and nearby-count < 15 [
      set panic-level 2
      set speed base-speed * 1.5
    ]
    if nearby-count >= 5 and nearby-count < 10 [
      set panic-level 1
      set speed base-speed * 1.2
    ]
    if nearby-count < 5 [
      set panic-level 0
      set speed base-speed
    ]
  ]
end

to calculate-stampede-forces
  ask patches with [not is-obstacle?] [
    let patch-force 0
    
    ask turtles-here with [not dead?] [
      set patch-force patch-force + (mass * speed)
    ]
    
    ask turtles-here with [not dead? and not injured?] [
      if patch-force >= health [
        record-stampede-death
        die
      ]
    ]
  ]
end

to record-stampede-death
  ifelse gender = "female" [
    set female-stampede-deaths female-stampede-deaths + 1
  ] [
    set male-stampede-deaths male-stampede-deaths + 1
  ]
  
  if age-group = "child" [ set child-stampede-deaths child-stampede-deaths + 1 ]
  if age-group = "adult" [ set adult-stampede-deaths adult-stampede-deaths + 1 ]
  if age-group = "elderly" [ set elderly-stampede-deaths elderly-stampede-deaths + 1 ]
  
  set death-count death-count + 1
  
  print (word "Osoba je umrla od gaženja u ticku " ticks " (" gender ", " age-group ")")
end

to initiate-evacuation
  set panic-started true
  set evacuation-started-at ticks
  
  ask turtles [
    set state "exit"
  ]

  print ""
  print "Započinje evakuacija nakon završetka koncerta."
  print (word "Trenutni tick: " ticks)
  print (word "Preostali broj osoba: " count turtles)
  print (word "Ukupan broj ranih izlazaka: " early-exits-count)
end


to update-density
  ask patches with [not is-obstacle?] [
    set density count turtles-here
    
    ;; Heatmap logic
    ifelse show-heatmap [
      set heat-intensity (density * 10)
      if heat-intensity > 100 [ set heat-intensity 100 ]
      
      ;; Apply scale-color ONLY to black patches to protect scenery
      if pcolor = black or (pcolor >= 10 and pcolor <= 19) [
        ifelse density > 0 [
          set pcolor scale-color red heat-intensity 0 100
        ] [
          set pcolor black
        ]
      ]
    ] [
      ;; If heatmap is OFF, clean up any heatmap artifacts on the floor
      if pcolor >= 12 and pcolor <= 19 and not is-obstacle? and not is-exit-patch? [
         set pcolor black
      ]
    ]

    if density > max-density [
      set max-density density
      set peak-crowd-time ticks
    ]
  ]
end

to detect-bottlenecks
  set bottleneck-detected false
  ask patches with [is-exit-patch?] [
    if count turtles in-radius 3 > 12 [
      set bottleneck-detected true
    ]
  ]
end

to update-statistics
  if total-people > 0 [
    ;; Efficiency includes both who exited and who died
    set evacuation-efficiency ((exited-people + death-count) / total-people) * 100
  ]
  
  ;; Flow Rate calculation: every 50 ticks
  if ticks > 0 and ticks mod 50 = 0 [
    set flow-rate (exited-people - last-exited-count)
    set last-exited-count exited-people
  ]
end

to check-completion
  if not any? turtles with [not dead?] [
    if evacuation-time = 0 [
      set evacuation-time (ticks - concert-duration)
      if evacuation-time < 0 [ set evacuation-time 0 ]
      
      set avg-exit-time 0
      if total-people > 0 [
        set avg-exit-time (evacuation-time / total-people)
      ]

      print ""
      print "Evakuacija je uspješno završena."
      print (word "Ukupno trajanje evakuacije: " evacuation-time " tickova.")
      print (word "Ukupan broj evakuisanih osoba: " total-people)
      print (word "Broj ranih izlazaka: " early-exits-count " (" precision (early-exits-count / max list 1 total-people * 100) 1 "%)")
      print (word "Lijevi izlaz: " exit-left-count " | Desni izlaz: " exit-right-count)
      print (word "Broj povrijeđenih: " injured-count)
      print (word "Broj mrtvih: " death-count)
      print (word "Maksimalna gustoća: " max-density " osoba (tick " peak-crowd-time ")")
      print (word "Efikasnost evakuacije: " precision evacuation-efficiency 1 "%")
    ]
  ]

  if ticks > concert-duration + 5000 [
    print (word "Maksimalno vrijeme simulacije je isteklo u ticku " ticks)
    stop
  ]
end]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="434" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="434" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <slider x="5" step="50" y="10" max="1100" width="250" display="concert-duration" height="50" min="0" direction="Horizontal" default="450.0" variable="concert-duration"></slider>
    <switch x="10" y="265" height="40" on="false" variable="add-obstacles" width="105" display="add-obstacles"></switch>
    <slider x="5" step="50" y="65" max="1500" width="250" display="ukupno-prisutnih" height="50" min="0" direction="Horizontal" default="950.0" variable="ukupno-prisutnih"></slider>
    <slider x="5" step="0.01" y="415" max="0.30" width="250" display="prosjecna-brzina-kretanja" height="50" min="0.01" direction="Horizontal" default="0.05" variable="prosjecna-brzina-kretanja"></slider>
    <slider x="5" step="5" y="475" max="100" width="250" display="nivo-stresa-za-paniku" height="50" min="0" direction="Horizontal" default="60.0" variable="nivo-stresa-za-paniku"></slider>
    <slider x="5" step="0.1" y="535" max="20.0" width="250" display="sansa-za-povredu" height="50" min="0" direction="Horizontal" default="5.0" variable="sansa-za-povredu"></slider>
    <slider x="5" step="0.0001" y="595" max="1.0" width="250" display="sansa-za-smrt (%)" height="50" min="0" direction="Horizontal" default="1.0E-4" variable="sansa-za-smrt (%)"></slider>
    <slider x="5" step="1" y="655" max="100" width="250" display="sansa-za-nelagodu" height="50" min="0" direction="Horizontal" default="10.0" variable="sansa-za-nelagodu"></slider>
    <slider x="5" step="1" y="715" max="3" width="250" display="broj-izlaza" height="50" min="2" direction="Horizontal" default="2.0" variable="broj-izlaza"></slider>
    <switch x="15" y="310" height="40" on="false" variable="panic-mode" width="95" display="panic-mode"></switch>
    <switch x="15" y="360" height="40" on="false" variable="show-heatmap" width="110" display="show-heatmap"></switch>
    <button x="270" y="65" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55" display="Go">go</button>
    <monitor x="10" precision="17" y="120" height="60" fontSize="11" width="100" display="Raniji izlasci">early-exits-count</monitor>
    <monitor x="10" precision="17" y="185" height="60" fontSize="11" width="100" display="Povrijeđeni">injured-count</monitor>
    <monitor x="115" precision="17" y="185" height="60" fontSize="11" width="100" display="Mrtvi">death-count</monitor>
    <plot x="810" autoPlotX="true" yMax="1100.0" autoPlotY="true" yAxis="Osobe" y="5" xMin="0.0" height="310" legend="true" xMax="10.0" yMin="0.0" width="220" xAxis="Ticks" display="Evakuacija">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Ukupno" color="-16777216" legend="true">
        <setup></setup>
        <update>plot count turtles</update>
      </pen>
      <pen interval="1.0" mode="0" display="Izašli" color="-16711936" legend="true">
        <setup></setup>
        <update>plot exited-people</update>
      </pen>
    </plot>
    <button x="270" y="15" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="Setup">setup</button>
    <plot x="810" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Osobe" y="325" xMin="0.0" height="150" legend="false" xMax="10.0" yMin="0.0" width="405" xAxis="Ticks" display="Povrijeđeni kroz vrijeme">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-66658" legend="true">
        <setup></setup>
        <update>plot injured-count</update>
      </pen>
    </plot>
    <plot x="1035" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Osobe" y="5" xMin="0.0" height="310" legend="false" xMax="10.0" yMin="0.0" width="240" xAxis="Ticks" display="Mrtvi kroz vrijeme">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-1" legend="true">
        <setup></setup>
        <update>plot death-count</update>
      </pen>
    </plot>
  </widgets>
  <info>## WHAT IS IT?

(a general understanding of what the model is trying to show or explain)

## HOW IT WORKS

(what rules the agents use to create the overall behavior of the model)

## HOW TO USE IT

(how to use the model, including a description of each of the items in the Interface tab)

## THINGS TO NOTICE

(suggested things for the user to notice while running the model)

## THINGS TO TRY

(suggested things for the user to try to do (move sliders, switches, etc.) with the model)

## EXTENDING THE MODEL

(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)

## NETLOGO FEATURES

(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)

## RELATED MODELS

(models in the NetLogo Models Library and elsewhere which are of related interest)

## CREDITS AND REFERENCES

(a reference to the model's URL on the web if it has one, as well as any other necessary credits, citations, and links)
</info>
